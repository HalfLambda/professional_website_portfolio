---
import { siteConfig } from '../config/site';
---

<footer class="border-t border-slate-200 dark:border-dark-border bg-white dark:bg-dark-bg/60 py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Bio & Mission -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="h-6 w-6 rounded bg-slate-900 dark:bg-white text-white dark:text-slate-950 font-mono font-bold flex items-center justify-center text-xs">
            OK
          </div>
          <span class="font-bold text-slate-900 dark:text-white text-sm">
            {siteConfig.name}
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md leading-relaxed">
          {siteConfig.description}
        </p>
        <div class="pt-2 text-xs font-mono text-slate-400 dark:text-slate-500">
          Curated for US O-1A / UK GTV Public Record & Enterprise Engineering.
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">
          Sitemap
        </h4>
        <ul class="space-y-2 text-xs">
          {siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Connect & Socials -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">
          Network & Code
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href={siteConfig.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center gap-2"
            >
              <span>GitHub</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center gap-2"
            >
              <span>LinkedIn</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center gap-2"
            >
              <span>YouTube Channel</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.topmateUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center gap-2"
            >
              <span>Topmate 1:1 Mentorship</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-slate-200/80 dark:border-dark-border/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 dark:text-slate-500">
      <div>
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </div>
      <div class="flex items-center gap-4 font-mono text-[11px]">
        <span>Built with Astro 5 & Tailwind</span>
        <span>•</span>
        <span>Hosted at the Edge</span>
        <span>•</span>
        <span class="text-emerald-500">● 100/100 Lighthouse Target</span>
      </div>
    </div>
  </div>
</footer>

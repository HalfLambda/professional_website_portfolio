---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  status: string;
  tech: string[];
  githubUrl?: string;
  youtubeUrl?: string;
}

const {
  title,
  description,
  slug,
  category,
  status,
  tech,
  githubUrl,
  youtubeUrl,
} = Astro.props;

const statusColor =
  status === 'Active Lab'
    ? 'text-sky-400 border-sky-800/60 bg-sky-950/40'
    : status === 'Completed'
    ? 'text-emerald-400 border-emerald-800/60 bg-emerald-950/40'
    : 'text-amber-400 border-amber-800/60 bg-amber-950/40';
---

<div class="group relative rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card p-6 hover:border-sky-500/50 dark:hover:border-sky-500/50 transition-all duration-300 hover:shadow-lg dark:hover:shadow-sky-500/5 flex flex-col justify-between">
  <div>
    <!-- Top Metadata: Category & Status -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-dark-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-dark-border">
        {category}
      </span>
      <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${statusColor}`}>
        ● {status}
      </span>
    </div>

    <!-- Title & Description -->
    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-500 dark:group-hover:text-sky-400 transition-colors mb-2">
      <a href={`/labs/${slug}`}>
        {title}
      </a>
    </h3>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {tech.map((item) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-dark-surface text-slate-600 dark:text-slate-400">
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- Links / Actions -->
  <div class="pt-4 border-t border-slate-100 dark:border-dark-border/60 flex items-center justify-between">
    <div class="flex items-center gap-3">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white flex items-center gap-1 transition-colors"
          title="Inspect Repository"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>Code</span>
        </a>
      )}

      {youtubeUrl && (
        <a
          href={youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-red-600 dark:text-red-400 hover:text-red-700 flex items-center gap-1 transition-colors"
          title="Watch Video Breakdown"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Video</span>
        </a>
      )}
    </div>

    <a
      href={`/labs/${slug}`}
      class="text-xs font-semibold font-mono text-sky-600 dark:text-sky-400 group-hover:translate-x-0.5 transition-transform flex items-center gap-1"
    >
      <span>Deep Dive</span>
      <span>→</span>
    </a>
  </div>
</div>

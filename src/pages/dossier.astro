---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const productionSkills = [
  'Google BigQuery',
  'Apache Spark / PySpark',
  'Apache Airflow / Cloud Composer',
  'Oracle Exadata',
  'Apache NiFi',
  'Databricks',
  'PostgreSQL',
  'dbt / Dataform',
  'Cloud Storage & GCS',
  'Distributed SQL Optimization',
  'Docker & Containerization',
  'CI/CD Data Pipelines',
  'Data Governance & IAM',
];

const appliedAISkills = [
  'Python (Advanced)',
  'Model Context Protocol (MCP)',
  'DuckDB (In-Memory OLAP)',
  'Polars (Arrow Columnar)',
  'FastAPI',
  'Information Retrieval (BM25)',
  'Hybrid Search (RRF)',
  'Vector DBs (Qdrant)',
  'Cross-Encoder Re-Ranking',
  'RAG Systems Engineering',
  'Local LLM Workflows (Ollama)',
  'Pydantic Output Validation',
];
---

<Layout
  title="Dossier, Credentials & Visa Evidence | Ozair Khan"
  description="Verified academic credentials (UIUC MCS Candidate), enterprise track record, technical radar, and public evidence record curated for US O-1A and UK Global Talent Visa."
>
  <div class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="mb-12">
        <div class="text-xs font-mono uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">
          Public Dossier // Pillar D
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          Credentials, Track Record & Evidence Hub
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          An authoritative, living record of academic research, enterprise architectural achievements, and technical contributions. Curated to serve technical hiring committees, conference boards, and legal adjudicators for <strong>US O-1A (Extraordinary Ability)</strong> and <strong>UK Global Talent Visa (Tech Nation)</strong>.
        </p>

        <!-- Quick Contacts Bar -->
        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
          <a
            href={siteConfig.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 dark:hover:text-white flex items-center gap-1 transition-colors"
          >
            <span>GitHub Profile</span>
            <span>↗</span>
          </a>
          <span>•</span>
          <a
            href={siteConfig.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 dark:hover:text-white flex items-center gap-1 transition-colors"
          >
            <span>LinkedIn Profile</span>
            <span>↗</span>
          </a>
          <span>•</span>
          <a
            href={siteConfig.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 dark:hover:text-white flex items-center gap-1 transition-colors"
          >
            <span>YouTube Channel</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- SECTION 1: ACADEMIC CREDENTIALS & RESEARCH -->
      <section class="mb-14 pb-12 border-b border-slate-200 dark:border-dark-border">
        <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">
          01 // Academic Credentials & Formal Research
        </h2>

        <div class="space-y-6">
          <!-- UIUC MCS -->
          <div class="p-6 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                University of Illinois Urbana-Champaign (UIUC)
              </h3>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60">
                Master of Computer Science (MCS)
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mb-4">
              Grainger College of Engineering • In Progress
            </p>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              Advanced graduate study specializing in distributed data systems, text retrieval, and applied machine learning:
            </p>
            <ul class="space-y-2 text-xs font-mono text-slate-600 dark:text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-bold">›</span>
                <div>
                  <strong>CS 410: Text Information Systems (Text Retrieval):</strong> Inverted indices, vector space models, Okapi BM25 ranking, language modeling for IR, topic categorization, and hybrid search pipelines.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-bold">›</span>
                <div>
                  <strong>CS 441: Applied Machine Learning:</strong> Supervised classification, dimensionality reduction (PCA), deep learning fundamentals, clustering, and evaluating model generalization on real-world datasets.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-bold">›</span>
                <div>
                  <strong>Data Cleaning & Transformation:</strong> Entity resolution, schema reconciliation, missing value imputation, and automated data quality validation.
                </div>
              </li>
            </ul>
          </div>

          <!-- B.E. Degree -->
          <div class="p-6 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                Bachelor of Engineering (B.E.)
              </h3>
              <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                Graduated
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">
              Electronics & Telecommunication Engineering
            </p>
            <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
              Rigorous quantitative foundation in signals & systems, digital signal processing, algorithm design, and probability theory.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 2: SPECIALIZED AI & AGENTIC CERTIFICATIONS -->
      <section class="mb-14 pb-12 border-b border-slate-200 dark:border-dark-border">
        <h2 class="text-xs font-mono uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-4">
          02 // Advanced AI & Agentic Specializations
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="text-xs font-mono text-purple-500 mb-1">Ed Donner • AI Engineering</div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-2">
              AI Engineer Core Track
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              LLM Engineering, Advanced RAG architectures, Fine-tuning with QLoRA, and Autonomous Multi-Agent systems design.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="text-xs font-mono text-purple-500 mb-1">Ed Donner • Agentic Systems</div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-2">
              The Complete Agent & MCP Course
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Deep dive into Anthropic's Model Context Protocol (MCP), building custom tools/resources, SSE & stdio transports, and multi-agent coordination.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 3: TECHNICAL RADAR -->
      <section class="mb-14 pb-12 border-b border-slate-200 dark:border-dark-border">
        <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-6">
          03 // Technical Radar & Production Competencies
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Pillar 1: Production Mastery -->
          <div class="p-6 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="flex items-center gap-2 mb-3">
              <span class="h-2 w-2 rounded-full bg-sky-500"></span>
              <h3 class="text-sm font-bold font-mono text-slate-900 dark:text-white uppercase tracking-wider">
                Production Mastery (Enterprise Scale)
              </h3>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
              Proven in multi-terabyte production data warehouses and zero-downtime cutover migrations.
            </p>
            <div class="flex flex-wrap gap-2">
              {productionSkills.map((skill) => (
                <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-100 dark:bg-dark-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-dark-border">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Pillar 2: Applied AI & Modern Data Stack -->
          <div class="p-6 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card">
            <div class="flex items-center gap-2 mb-3">
              <span class="h-2 w-2 rounded-full bg-purple-500"></span>
              <h3 class="text-sm font-bold font-mono text-slate-900 dark:text-white uppercase tracking-wider">
                Applied AI & Modern Data Stack
              </h3>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
              Modern in-memory compute, vector retrieval, and agentic integrations for next-gen data systems.
            </p>
            <div class="flex flex-wrap gap-2">
              {appliedAISkills.map((skill) => (
                <span class="text-xs font-mono px-2.5 py-1 rounded bg-purple-50 dark:bg-purple-950/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: SPEAKING, COMMUNITY & LEADERSHIP -->
      <section class="mb-14">
        <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">
          04 // Speaking, Community & Leadership
        </h2>

        <div class="space-y-4">
          <div class="p-5 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="text-xs font-mono text-amber-500 mb-1">Communication & Leadership</div>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">
                Toastmasters International
              </h4>
              <p class="text-xs text-slate-600 dark:text-slate-400">
                Active member practicing executive presentation, technical storytelling, and impromptu leadership.
              </p>
            </div>
            <span class="text-xs font-mono text-slate-400">Active</span>
          </div>

          <div class="p-5 rounded-xl border border-slate-200 dark:border-dark-border bg-white dark:bg-dark-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="text-xs font-mono text-sky-500 mb-1">Technical Education & Outreach</div>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">
                YouTube Technical Walkthroughs & Code Breakdowns
              </h4>
              <p class="text-xs text-slate-600 dark:text-slate-400">
                Publishing open-source code explanations on data pipeline architectures, DuckDB/Polars automations, and MCP implementations.
              </p>
            </div>
            <a
              href={siteConfig.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-sky-500 hover:underline flex items-center gap-1"
            >
              <span>Watch Channel</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <!-- VISA ATTESTATION FOOTER -->
      <div class="p-6 rounded-xl border border-emerald-300/40 dark:border-emerald-800/60 bg-emerald-50/30 dark:bg-emerald-950/20">
        <div class="flex items-center gap-2 mb-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <h3 class="text-sm font-bold font-mono text-emerald-800 dark:text-emerald-300">
            Immigration Counsel & Reference Letter Verifications
          </h3>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          For legal adjudicators, recommender signatories, or conference review boards requiring certified copies of diplomas, official enterprise impact attestation letters, or code repositories, please contact directly via <a href={`mailto:${siteConfig.email}`} class="text-emerald-600 dark:text-emerald-400 font-mono underline">{siteConfig.email}</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

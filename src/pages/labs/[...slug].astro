---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('labs');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'labs'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} | Ozair Khan`}
  description={post.data.description}
  article={true}
>
  <article class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Back Link -->
      <a
        href="/labs"
        class="inline-flex items-center gap-2 text-xs font-mono font-medium text-slate-500 hover:text-purple-600 dark:text-slate-400 dark:hover:text-purple-400 mb-8 transition-colors"
      >
        <span>←</span>
        <span>Back to AI & Data Labs</span>
      </a>

      <!-- Header -->
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-dark-border">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <span class="text-xs font-mono font-medium px-2.5 py-1 rounded bg-slate-100 dark:bg-dark-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-dark-border">
            {post.data.category}
          </span>
          <span class="text-xs font-mono px-2.5 py-0.5 rounded-full border border-sky-800/60 bg-sky-950/40 text-sky-400">
            ● {post.data.status}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          {post.data.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          {post.data.description}
        </p>

        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tech.map((t) => (
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-100 dark:bg-dark-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-dark-border">
              {t}
            </span>
          ))}
        </div>

        <!-- External Artifacts Links (GitHub + YouTube) -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {post.data.githubUrl && (
            <a
              href={post.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-slate-300 dark:border-dark-border bg-white dark:bg-dark-card hover:bg-slate-100 dark:hover:bg-dark-surface text-slate-800 dark:text-slate-200 font-mono text-xs transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub Repository</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          )}

          {post.data.youtubeUrl && (
            <a
              href={post.data.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-red-300/40 dark:border-red-900/60 bg-red-50/50 dark:bg-red-950/20 hover:bg-red-100/50 dark:hover:bg-red-950/40 text-red-700 dark:text-red-400 font-mono text-xs transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>Video Breakdown</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
        </div>
      </header>

      <!-- Markdown / MDX Body -->
      <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-pre:bg-dark-card prose-pre:border prose-pre:border-dark-border">
        <Content />
      </div>

      <!-- Footer CTA -->
      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-dark-border flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-white">
            Have questions or want to collaborate on this open-source lab?
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Open an issue on GitHub, drop a comment on YouTube, or reach out directly.
          </p>
        </div>
        <a
          href="/labs"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 dark:border-dark-border hover:bg-slate-100 dark:hover:bg-dark-surface text-slate-800 dark:text-slate-200 font-semibold text-xs transition-all whitespace-nowrap"
        >
          <span>More Labs</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
